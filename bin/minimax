#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Run MiniMax Claude wrapper with Codex support currently paused.

Usage:
  minimax [claude args...]
  minimax claude [args...]
  minimax codex [args...]
  minimax

Examples:
  minimax -p "Explain this repository"
  minimax claude -p "Explain this repository"

Notes:
  - `minimax` with no args runs Claude Code.
  - `minimax codex` is currently unsupported in this wrapper.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

run_codex() {
  exit_codex_paused
}

run_claude() {
  exec "${SCRIPT_DIR}/claude-mm" "$@"
}

if [[ $# -eq 0 ]]; then
  run_claude
fi

case "$1" in
  codex)
    shift
    run_codex "$@"
    ;;
  claude)
    shift
    run_claude "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    run_claude "$@"
    ;;
esac
