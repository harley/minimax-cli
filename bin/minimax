#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Run MiniMax wrappers for Codex CLI or Claude Code.

Usage:
  minimax <codex|claude> [args...]
  minimax

Examples:
  minimax codex chat
  minimax claude -p "Explain this repository"
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

run_codex() {
  exec "${SCRIPT_DIR}/codex-mm" "$@"
}

run_claude() {
  exec "${SCRIPT_DIR}/claude-mm" "$@"
}

if [[ $# -eq 0 ]]; then
  if [[ -t 0 && -t 1 ]]; then
    echo "Choose runtime:"
    echo "  1) codex"
    echo "  2) claude"
    printf "Enter choice [1-2]: "
    read -r choice
    case "${choice}" in
      1|codex)
        run_codex
        ;;
      2|claude)
        run_claude
        ;;
      *)
        echo "Error: invalid choice '${choice}'." >&2
        exit 1
        ;;
    esac
  else
    usage >&2
    exit 1
  fi
fi

case "$1" in
  codex)
    shift
    run_codex "$@"
    ;;
  claude)
    shift
    run_claude "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Error: unknown target '$1'. Use 'codex' or 'claude'." >&2
    usage >&2
    exit 1
    ;;
esac

