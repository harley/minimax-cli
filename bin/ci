#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

SCRIPTS=(
  "${REPO_ROOT}/bin/lib/common.sh"
  "${REPO_ROOT}/bin/minimax"
  "${REPO_ROOT}/bin/codex-mm"
  "${REPO_ROOT}/bin/claude-mm"
  "${REPO_ROOT}/bin/ci"
  "${REPO_ROOT}/scripts/install.sh"
  "${REPO_ROOT}/scripts/bootstrap-install.sh"
  "${REPO_ROOT}/scripts/uninstall.sh"
  "${REPO_ROOT}/install.sh"
  "${REPO_ROOT}/uninstall.sh"
  "${REPO_ROOT}/minimax"
  "${REPO_ROOT}/codex-mm"
  "${REPO_ROOT}/claude-mm"
)

echo "==> bash syntax check"
bash -n "${SCRIPTS[@]}"

if command -v shellcheck >/dev/null 2>&1; then
  echo "==> shellcheck"
  shellcheck "${SCRIPTS[@]}"
else
  echo "==> shellcheck skipped (not installed)"
fi

echo "==> cli help smoke tests"
"${REPO_ROOT}/install.sh" --help >/dev/null
"${REPO_ROOT}/uninstall.sh" --help >/dev/null
"${REPO_ROOT}/scripts/bootstrap-install.sh" --help >/dev/null
"${REPO_ROOT}/bin/minimax" --help >/dev/null

echo "==> install/uninstall smoke test"
TMP_BIN="$(mktemp -d "${TMPDIR:-/tmp}/minimax-cli.XXXXXX")"
trap 'rm -rf "${TMP_BIN}"' EXIT

"${REPO_ROOT}/install.sh" --bin-dir "${TMP_BIN}" >/dev/null
test -e "${TMP_BIN}/minimax"
test -e "${TMP_BIN}/codex-mm"
test -e "${TMP_BIN}/claude-mm"
test -e "${TMP_BIN}/lib/common.sh"

# Ensure installed wrappers can source shared library from install location.
"${TMP_BIN}/minimax" --help >/dev/null
if "${TMP_BIN}/codex-mm" --help >/tmp/minimax-codex-smoke.log 2>&1; then
  echo "Error: codex-mm should fail while codex support is paused." >&2
  exit 1
fi
if ! grep -q "platform.minimax.io/docs/coding-plan/codex-cli" /tmp/minimax-codex-smoke.log; then
  echo "Error: codex-mm output missing codex docs URL." >&2
  exit 1
fi
if MINIMAX_API_KEY=dummy "${TMP_BIN}/minimax" codex >/tmp/minimax-minimax-codex-smoke.log 2>&1; then
  echo "Error: minimax codex should fail while codex support is paused." >&2
  exit 1
fi
if ! grep -q "platform.minimax.io/docs/coding-plan/codex-cli" /tmp/minimax-minimax-codex-smoke.log; then
  echo "Error: minimax codex output missing codex docs URL." >&2
  exit 1
fi
MINIMAX_API_KEY=dummy "${TMP_BIN}/claude-mm" --help >/tmp/minimax-claude-smoke.log 2>&1 || true
if grep -q "No such file or directory" /tmp/minimax-codex-smoke.log /tmp/minimax-minimax-codex-smoke.log /tmp/minimax-claude-smoke.log; then
  echo "Error: installed wrapper could not resolve shared library." >&2
  exit 1
fi

"${REPO_ROOT}/uninstall.sh" --bin-dir "${TMP_BIN}" >/dev/null
if [[ -e "${TMP_BIN}/minimax" || -e "${TMP_BIN}/codex-mm" || -e "${TMP_BIN}/claude-mm" || -e "${TMP_BIN}/lib/common.sh" ]]; then
  echo "Error: uninstall smoke test failed." >&2
  exit 1
fi

echo "All checks passed."
