#!/usr/bin/env bash
set -euo pipefail

# MiniMax Claude Wrapper
# Usage: claude-mm [claude args]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

ensure_command "claude" "Install Claude Code first."
ensure_minimax_api_key

MINIMAX_CLAUDE_BASE_URL="${MINIMAX_CLAUDE_BASE_URL:-https://api.minimax.io/anthropic}"
MINIMAX_CLAUDE_MODEL="${MINIMAX_CLAUDE_MODEL:-MiniMax-M2.5}"

export ANTHROPIC_BASE_URL="${MINIMAX_CLAUDE_BASE_URL}"
export ANTHROPIC_AUTH_TOKEN="${MINIMAX_API_KEY}"
export API_TIMEOUT_MS="${API_TIMEOUT_MS:-3000000}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-$MINIMAX_CLAUDE_MODEL}"
export ANTHROPIC_SMALL_FAST_MODEL="${ANTHROPIC_SMALL_FAST_MODEL:-$MINIMAX_CLAUDE_MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-$MINIMAX_CLAUDE_MODEL}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-$MINIMAX_CLAUDE_MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-$MINIMAX_CLAUDE_MODEL}"

exec claude "$@"

